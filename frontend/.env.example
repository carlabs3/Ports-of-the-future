# Ports of the Future — frontend environment variables (Vite).
# Copy to .env for local overrides. Only VITE_-prefixed vars reach the client.

# Base URL of the backend API + Socket.io server.
# Local dev: leave unset — the app falls back to http://localhost:5000.
# Production (Vercel): set this to the Railway backend URL, e.g.
#   VITE_BACKEND_URL=https://your-backend.up.railway.app
VITE_BACKEND_URL=http://localhost:5000
