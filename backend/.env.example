# Ports of the Future — backend environment variables.
# Copy this file to .env and fill in real values. NEVER commit the real .env.

# HTTP port the server listens on. Optional (defaults to 5000).
PORT=5000

# MongoDB connection string. Required in production.
# Local example: mongodb://127.0.0.1:27017/portsofthefuture
MONGODB_URI=mongodb://127.0.0.1:27017/portsofthefuture

# Secret used to sign JWT auth tokens. REQUIRED in production — set a long random string.
JWT_SECRET=cambiame-en-produccion

# Allowed frontend origin(s) for CORS + Socket.io. Optional (defaults to the
# Vite dev origins). Accepts a single origin OR a comma-separated list, so you
# can allow local + production at once. No trailing slash.
# Example (prod): FRONTEND_URL=https://your-frontend.vercel.app
# Example (both): FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Initial admin user, created on first startup if it does not exist.
# Defaults (admin@portsofthefuture.com / admin123) apply ONLY for local dev.
# MUST be overridden in production with a real email and a strong password.
ADMIN_EMAIL=admin@portsofthefuture.com
ADMIN_PASSWORD=cambiame-en-produccion

# Email delivery (Resend). Optional — if unset, email endpoints return 503 gracefully.
RESEND_API_KEY=cambiame-en-produccion
